# Path to the persistent storage on the host machine.
# Use a local HDD: venv and caches are unreliable on a network share.
HDD_PATH=/mnt/hdd/ohashi

# Names for the image and container
IMAGE_NAME=ohashi-sandbox
CONTAINER_NAME=ohashi_sandbox

# Bind address and port for the file browser web UI
FILEBROWSER_BIND=127.0.0.1
FILEBROWSER_PORT=8080
FILEBROWSER_CONTAINER_NAME=ohashi-filebrowser

# Tailscale settings for stable SSH access to the host
TS_HOSTNAME=experiment-host
TAILSCALE_CONTAINER_NAME=experiment-tailscale
TAILSCALE_STATE_VOLUME=experiment-tailscale-state
