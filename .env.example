# Path to your NAS mount on the host machine
NAS_PATH=/mnt/nas/ohashi

# Names for the image and container
IMAGE_NAME=ohashi-sandbox
CONTAINER_NAME=ohashi_sandbox

# Port for the web file browser (Visualization)
VIZ_BIND=127.0.0.1
VIZ_PORT=8080

# Tailscale settings for stable SSH access to the host
TS_HOSTNAME=experiment-host
TAILSCALE_CONTAINER_NAME=experiment-tailscale
TAILSCALE_STATE_VOLUME=experiment-tailscale-state
